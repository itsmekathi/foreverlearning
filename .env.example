# --- Added for you by Vercel → Storage (don't create these by hand) ---
# Neon database → DATABASE_URL (also POSTGRES_URL, etc.)
# Blob store    → BLOB_READ_WRITE_TOKEN
# For local dev, copy them down with:  npx vercel link  &&  npx vercel env pull .env.local
DATABASE_URL=
BLOB_READ_WRITE_TOKEN=

# --- Auth (GitHub OAuth app: https://github.com/settings/developers) ---
# Callback URLs: https://<your-app>.vercel.app/api/auth/callback/github  (and http://localhost:3000/... for local)
AUTH_SECRET=            # run: npx auth secret
AUTH_GITHUB_ID=
AUTH_GITHUB_SECRET=
ALLOWED_GITHUB_USERS=   # your GitHub username(s), comma-separated

# --- The Git repository that holds your PDFs ---
GITHUB_REPO=owner/my-books
GITHUB_BRANCH=main
GITHUB_BOOKS_PATH=      # optional sub-folder, e.g. "books"
GITHUB_TOKEN=           # fine-grained token, read-only "Contents" on that repo

# --- Blob cache cleanup ---
BLOB_TTL_DAYS=3         # delete cached copies not read for this many days
CRON_SECRET=            # any random string; Vercel sends it to the cleanup cron
